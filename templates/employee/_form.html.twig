{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
    <div class="mb-3">
        {{ form_label(form.name, 'Name', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.name) }}
    </div>
    
    <div class="mb-3">
        {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.email) }}
    </div>
    
    <div class="mb-3">
        {{ form_label(form.position, 'Position', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.position, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.position) }}
    </div>
    
    <div class="mb-3">
        {{ form_label(form.projects, 'Projects', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.projects, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.projects) }}
    </div>
    
    <div class="d-grid gap-2">
        <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
    </div>
{{ form_end(form) }}