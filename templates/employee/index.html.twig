{% extends 'base.html.twig' %}

{% block title %}Employee index{% endblock %}

{% block body %}
    <h1>Employees </h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Position</th>
                <th>Projects</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for employee in employees %}
            <tr>
                <td>{{ employee.id }}</td>
                <td>{{ employee.name }}</td>
                <td>{{ employee.email }}</td>
                <td>{{ employee.position }}</td>
                <td>
                    {% for project in employee.projects %}
                        {{ project.name }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        <em>Sin proyectos</em>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-primary btn-md">show</a>
                    <a href="{{ path('app_employee_edit', {'id': employee.id}) }}" class="btn btn-warning btn-md">edit</a>
                    {{ include('employee/_delete_form.html.twig', {employee: employee}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-success btn-md" href="{{ path('app_employee_new') }}">Create new</a>
{% endblock %}
