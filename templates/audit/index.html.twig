{% extends 'base.html.twig' %}

{% block title %}Audit Records{% endblock %}

{% block body %}
    <h1>Audit Records</h1>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Affected Entity</th>
                <th>Action Type</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            {% for audit in audits %}
                <tr>
                    <td>{{ audit.id }}</td>
                    <td>{{ audit.username }}</td>
                    <td>{{ audit.affectedEntity }}</td>
                    <td>{{ audit.actionType }}</td>
                    <td>{{ audit.timestamp ? audit.timestamp|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">No records found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
